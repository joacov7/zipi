generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  role          UserRole @default(PASSENGER)
  avatarUrl     String?
  isActive      Boolean  @default(true)
  referralCode  String?  @unique
  referredBy    String?
  walletBalance Float    @default(0)
  cuit          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driver              Driver?
  tripsAsPassenger    Trip[]          @relation("PassengerTrips")
  deliveriesAsSender  Delivery[]      @relation("SenderDeliveries")
  freightAsRequester  FreightRequest[] @relation("RequesterFreight")
  refreshTokens       RefreshToken[]
  pushTokens          PushToken[]
  walletTransactions  WalletTransaction[]

  contractorProfile   ContractorProfile?
  serviceRequests     ServiceRequest[]    @relation("ClientRequests")
  serviceJobsAsClient ServiceJob[]        @relation("ClientJobs")

  @@map("users")
}

model WalletTransaction {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        WalletTransactionType
  description String
  tripId      String?
  createdAt   DateTime              @default(now())

  @@index([userId])
  @@map("wallet_transactions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Driver {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType  VehicleType
  vehiclePlate String      @unique
  vehicleModel String
  vehicleYear  Int
  vehicleColor String
  licenseNumber String     @unique
  isAvailable  Boolean     @default(false)
  isVerified   Boolean     @default(false)
  currentLat   Float?
  currentLng   Float?
  currentHeading Float?
  rating       Float       @default(5.0)
  totalTrips   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  trips          Trip[]
  deliveries     Delivery[]
  freightRequests FreightRequest[]

  // Campos extras para camiones/maquinaria
  truckType      TruckType?
  machineryType  MachineryType?
  capacityTons   Float?
  hasRefrigeration Boolean @default(false)

  @@map("drivers")
}

model FreightRequest {
  id                  String         @id @default(uuid())
  requesterId         String
  requester           User           @relation("RequesterFreight", fields: [requesterId], references: [id])
  driverId            String?
  driver              Driver?        @relation(fields: [driverId], references: [id])
  serviceType         FreightService
  pickupLat           Float
  pickupLng           Float
  pickupAddress       String
  dropoffLat          Float
  dropoffLng          Float
  dropoffAddress      String
  cargoDescription    String
  estimatedWeightTons Float?
  estimatedHours      Float?
  distanceKm          Float?
  requiresRefrigeration Boolean      @default(false)
  specialRequirements String?
  status              FreightStatus  @default(PENDING)
  estimatedPrice      Float
  finalPrice          Float?
  requesterRating     Int?
  driverRating        Int?
  cancelReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("freight_requests")
}

model Trip {
  id              String     @id @default(uuid())
  passengerId     String
  passenger       User       @relation("PassengerTrips", fields: [passengerId], references: [id])
  driverId        String?
  driver          Driver?    @relation(fields: [driverId], references: [id])
  originLat       Float
  originLng       Float
  originAddress   String
  destLat         Float
  destLng         Float
  destAddress     String
  status          TripStatus @default(PENDING)
  estimatedPrice  Float
  finalPrice      Float?
  estimatedMinutes Int?
  distanceKm      Float?
  passengerRating Int?
  driverRating    Int?
  cancelReason    String?
  cancelledBy     String?
  cancellationFee Float?
  discountCode    String?
  discountAmount  Float?
  surgeMultiplier   Float    @default(1.0)
  walletCreditsUsed Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt       DateTime   @updatedAt

  messages        TripMessage[]

  @@map("trips")
}

model TripMessage {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderId  String
  senderName String
  content   String
  createdAt DateTime @default(now())

  @@index([tripId])
  @@map("trip_messages")
}

model Delivery {
  id                 String         @id @default(uuid())
  senderId           String
  sender             User           @relation("SenderDeliveries", fields: [senderId], references: [id])
  driverId           String?
  driver             Driver?        @relation(fields: [driverId], references: [id])
  pickupLat          Float
  pickupLng          Float
  pickupAddress      String
  dropoffLat         Float
  dropoffLng         Float
  dropoffAddress     String
  packageDescription String
  recipientName      String
  recipientPhone     String
  status             DeliveryStatus @default(PENDING)
  estimatedPrice     Float
  finalPrice         Float?
  senderRating       Int?
  driverRating       Int?
  cancelReason       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("deliveries")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
  CONTRACTOR
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  HEAVY_MACHINERY
}

enum TruckType {
  PICKUP
  SMALL_TRUCK
  LARGE_TRUCK
  SEMI
}

enum MachineryType {
  EXCAVATOR
  CRANE
  BULLDOZER
  FORKLIFT
  CONCRETE_MIXER
  COMPACTOR
}

enum FreightService {
  FLETE
  MACHINERY
}

enum FreightStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  requests    ServiceRequest[]
  contractors ContractorService[]

  @@map("service_categories")
}

model ContractorProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio        String?
  cuit       String?
  isVerified Boolean  @default(false)
  isAvailable Boolean @default(false)
  rating     Float    @default(5.0)
  totalJobs  Int      @default(0)
  coverageKm Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  services   ContractorService[]
  quotes     ServiceQuote[]
  jobs       ServiceJob[]

  @@map("contractor_profiles")
}

model ContractorService {
  contractorId String
  categoryId   String
  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  category     ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contractorId, categoryId])
  @@map("contractor_services")
}

model ServiceRequest {
  id          String               @id @default(uuid())
  clientId    String
  client      User                 @relation("ClientRequests", fields: [clientId], references: [id])
  categoryId  String
  category    ServiceCategory      @relation(fields: [categoryId], references: [id])
  title       String
  description String
  address     String
  lat         Float?
  lng         Float?
  urgency     ServiceUrgency       @default(NORMAL)
  status      ServiceRequestStatus @default(OPEN)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  quotes      ServiceQuote[]
  job         ServiceJob?

  @@map("service_requests")
}

model ServiceQuote {
  id             String        @id @default(uuid())
  requestId      String
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  contractorId   String
  contractor     ContractorProfile @relation(fields: [contractorId], references: [id])
  price          Float
  description    String
  estimatedHours Int?
  status         QuoteStatus   @default(PENDING)
  createdAt      DateTime      @default(now())

  job            ServiceJob?

  @@map("service_quotes")
}

model ServiceJob {
  id              String    @id @default(uuid())
  requestId       String    @unique
  request         ServiceRequest    @relation(fields: [requestId], references: [id])
  quoteId         String    @unique
  quote           ServiceQuote      @relation(fields: [quoteId], references: [id])
  contractorId    String
  contractor      ContractorProfile @relation(fields: [contractorId], references: [id])
  clientId        String
  client          User              @relation("ClientJobs", fields: [clientId], references: [id])
  status          JobStatus @default(PENDING_PAYMENT)
  escrowAmount    Float
  platformFee     Float
  finalAmount     Float
  clientRating    Int?
  contractorRating Int?
  cancelReason    String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("service_jobs")
}

enum ServiceUrgency {
  URGENT
  NORMAL
  FLEXIBLE
}

enum ServiceRequestStatus {
  OPEN
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model ServiceZone {
  id        String   @id @default(uuid())
  name      String
  centerLat Float
  centerLng Float
  radiusKm  Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_zones")
}

model DiscountCode {
  id              String    @id @default(uuid())
  code            String    @unique
  description     String?
  discountPercent Int
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  minOrderAmount  Float?
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@map("discount_codes")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFERRAL_BONUS
  ADMIN_ADJUSTMENT
}
